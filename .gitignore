# ---------- 构建产物 ----------
# 关键：tingshu-parent 下有 6 个 100~110MB 的 jar，GitHub 拒收 >100MB 的单文件
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.jar
*.war
*.class

# ---------- 前端：只保留 mp-weixin，其余副本不入库 ----------
/mp-weixin1/
/mp-weixin2/
/mp-weixin3/

# ---------- IntelliJ IDEA（workspace.xml 含本机绝对路径）----------
.idea/
*.iml
*.iws
*.ipr
out/

# ---------- 日志与 JVM 崩溃转储 ----------
*.log
logs/
hs_err_pid*
replay_pid*

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地调试临时目录 ----------
.dsh-probe/
