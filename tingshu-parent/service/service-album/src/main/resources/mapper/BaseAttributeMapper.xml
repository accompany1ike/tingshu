<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >


<mapper namespace="com.atguigu.tingshu.album.mapper.BaseAttributeMapper">

    <!--
      自定义结果集：封装一对多，将某个标签下包含的标签值封装到一方集合属性 attributeValueList 中
      autoMapping：相同列名与属性名自动映射（attribute_name、category1_id、value_name、attribute_id）
    -->
    <resultMap id="baseAttributeMap" type="com.atguigu.tingshu.model.album.BaseAttribute" autoMapping="true">
        <!--一方：主键及普通字段-->
        <id column="id" property="id"></id>
        <!--collection：封装集合属性 attributeValueList，ofType 为多方类型-->
        <collection property="attributeValueList" ofType="com.atguigu.tingshu.model.album.BaseAttributeValue" autoMapping="true">
            <!--多方：主键（标签值ID取了别名，避免跟标签ID列名冲突）-->
            <id column="base_attribute_value_id" property="id"></id>
        </collection>
    </resultMap>

    <!--根据一级分类Id获取分类（标签名包含标签值） 列表：标签-标签值 一对多-->
    <select id="getAttributesByCategory1Id" resultMap="baseAttributeMap">
        select
            ba.id,
            ba.category1_id,
            ba.attribute_name,
            bav.id base_attribute_value_id,
            bav.attribute_id,
            bav.value_name
        from base_attribute ba
        left join base_attribute_value bav on bav.attribute_id = ba.id and bav.is_deleted = 0
        where ba.category1_id = #{category1Id}
          and ba.is_deleted = 0
        order by ba.id, bav.id
    </select>

</mapper>
